    default y

config MCUMGR_SMP_COMMAND_STATUS_HOOKS
    default y

config MCUMGR_TRANSPORT_NETBUF_SIZE
    default 2475

config SYSTEM_WORKQUEUE_STACK_SIZE
    default 2800

config BT_DRV_RX_STACK_SIZE
    default 1024

config BT_DRV_TX_STACK_SIZE
    default 1024

config BT_CENTRAL
    default n

config BT_PERIPHERAL
    default y

config MCUMGR_TRANSPORT_BT_REASSEMBLY
    default y

config BT_CTLR
    default y

config MCUMGR_TRANSPORT_BT_CONN_PARAM_CONTROL
    default y

config NCS_SAMPLE_MCUMGR_BT_OTA_DFU_SPEEDUP
    default y

config MCUMGR_GRP_OS_MCUMGR_PARAMS
	default y

config BT_BUF_ACL_TX_COUNT
    default 20

config BT_BUF_ACL_RX_COUNT
    default 20

