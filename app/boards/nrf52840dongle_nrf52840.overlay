&adc {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    io-channels = <&adc 0>; /* Add this line */

    channel@0 {
        reg = <0>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <NRF_SAADC_AIN7>; /* P0.31 for nRF52840 Dongle */
        zephyr,resolution = <12>;
        zephyr,oversampling = <8>;
    };
};

/ { 
        H_drive_en_pin: H-drive-en-pin {
                compatible = "nordic,gpio-pins";
                gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>;
                status = "okay";
        };

        A_in_pins: A-in-pins {
                compatible = "nordic,gpio-pins";
                gpios = <&gpio0 22 GPIO_ACTIVE_HIGH>, <&gpio0 24 GPIO_ACTIVE_HIGH>;
                status = "okay";
        };

        B_in_pins: B-in-pins {
                compatible = "nordic,gpio-pins";
                gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>, <&gpio0 02 GPIO_ACTIVE_HIGH>;
                status = "okay";
        };
};

&gpio0 {
        status = "okay";
};

&pinctrl {
    pwm0_default: pwm0_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 17)>,
                    <NRF_PSEL(PWM_OUT1, 0, 20)>;
        };
    };
    pwm0_sleep: pwm0_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 17)>,
                    <NRF_PSEL(PWM_OUT1, 0, 20)>;
            low-power-enable;
        };
    };
};