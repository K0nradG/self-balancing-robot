/ {
    zephyr,user {
        io-channels = <&adc 0>;
    };
};


&adc {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    channel@0 {
        reg = <0>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <NRF_SAADC_AIN7>; /* P0.31 for nRF52840 Dongle */
        zephyr,resolution = <12>;
        zephyr,oversampling = <8>;
    };
};

&gpio0 {
    a_in_pins {
        compatible = "gpio-keys";
        a_in1: a_in1 {
            gpios = <&gpio0 22 GPIO_ACTIVE_HIGH>;
        };
        a_in2: a_in2 {
            gpios = <&gpio0 24 GPIO_ACTIVE_HIGH>;
        };
    };
    b_in_pins{
        compatible = "gpio-keys";
        b_in2: b_in2 {
            gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
        };
    };
};

&gpio1 {
    b_in_pins{
        compatible = "gpio-keys";
        b_in1: b_in1 {
            gpios = <&gpio1 15 GPIO_ACTIVE_HIGH>;
        };
    };
    h_bridge_en_pin{
        compatible = "gpio-keys";
        h_b_en: h_b_en {
            gpios = <&gpio1 10 GPIO_ACTIVE_HIGH>;
        };
    };
};

/ {
    dc_1: dc_1 {
        compatible = "pwm-dc";
        pwms = <&pwm0 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
    };

    dc_2: dc_2 {
        compatible = "pwm-dc";
        pwms = <&pwm1 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
    };
};

&pwm0 {
    status = "okay";
    pinctrl-0 = <&pwm0_custom_motor>;
    pinctrl-1 = <&pwm0_csleep_motor>;
    pinctrl-names = "default", "sleep";
};

&pwm1 {
    status = "okay";
    pinctrl-0 = <&pwm1_custom_motor>;
    pinctrl-1 = <&pwm1_csleep_motor>;
    pinctrl-names = "default", "sleep";
};

&pinctrl {
    pwm0_custom_motor: pwm0_custom_motor {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 17)>;
            /*nordic,invert; - uncoment this if negative PWM is needed*/
        };
    };

    pwm0_csleep_motor: pwm0_csleep_motor {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 17)>;
            low-power-enable;
        };
    };

    pwm1_custom_motor: pwm1_custom_motor {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 20)>;
            /*nordic,invert; - uncoment this if negative PWM is needed*/
        };
    };

    pwm1_csleep_motor: pwm1_csleep_motor {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 20)>;
            low-power-enable;
        };
    };
};
