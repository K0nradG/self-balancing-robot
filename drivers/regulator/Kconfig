config REGULATOR_DRV
    bool "Regulator driver module"
    depends on IMU_DRV
    depends on MOTOR_CONTROLLER_DRV
    depends on !MODEL_IDENTIFICATION_DRV

if REGULATOR_DRV

config REGULATOR_SAMPLE_TIME
    int "Regulator sampling time in milliseconds"
    default 1

config REGULATOR_LOG
    bool "Enable logging from motors driver"
    depends on LOGGER_DRV

config FILTER_CUTOFF_FREQUENCY
    int "Filter cut-off frequency in Hz"
    default 40

endif #REGULATOR_DRV
